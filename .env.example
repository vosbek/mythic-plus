# Spotify Integration (optional)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/spotify/callback

# Database
DATABASE_URL=sqlite:///mythicplus.db

# WoW Addon Import
# Path to your WoW SavedVariables file for MythicPlusTracker
# Windows example: C:\Program Files\World of Warcraft\_retail_\WTF\Account\YOURACCOUNT\SavedVariables\MythicPlusTracker.lua
# Mac example: /Applications/World of Warcraft/_retail_/WTF/Account/YOURACCOUNT/SavedVariables/MythicPlusTracker.lua
WOW_SAVEDVARIABLES_PATH=

# Warcraft Logs (optional)
# Create a client at https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
